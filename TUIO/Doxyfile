# Doxyfile 1.5.6
# Project related configuration options
DOXYFILE_ENCODING = UTF-8
PROJECT_NAME = "TUIO C++ Developer API"
# Build related configuration options
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO
EXTRACT_LOCAL_CLASSES = YES
# only the public headers make up the API; skip .cpp implementation files
FILE_PATTERNS = *.h *.hpp
# use the project readme as the main page of the API documentation
INPUT = . ../readme.md
USE_MDFILE_AS_MAINPAGE = ../readme.md
# configuration options related to the HTML output
GENERATE_HTML = YES
HTML_OUTPUT = ../doc
HTML_FILE_EXTENSION = .html
GENERATE_TREEVIEW = YES 
GENERATE_LATEX = NO
